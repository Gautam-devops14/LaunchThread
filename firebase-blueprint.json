{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "Potential client capturing lead magnet details.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "description": "Full name of the lead" },
        "email": { "type": "string", "format": "email", "description": "Email address" },
        "phoneNumber": { "type": "string", "description": "Phone number of the lead" },
        "websiteUrl": { "type": "string", "format": "uri", "description": "Current website URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of capture" }
      },
      "required": ["fullName", "email", "phoneNumber", "createdAt"]
    }
  },
  "firestore": {
    "leads/{leadId}": {
      "schema": "Lead",
      "description": "Collection of leads captured through audits."
    }
  }
}
